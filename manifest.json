{
  "manifest_version": 3,
  "name": "CRT TV Frame",
  "version": "1.0.0",
  "description": "Frames YouTube and other web videos in a retro television set instead of plain black bars.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CRT TV Frame",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["frame.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
